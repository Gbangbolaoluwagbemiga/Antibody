# Antibody — deployment configuration
# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed template.
#
# Nothing chain-specific is hardcoded in source. The v4-template's BaseScript shipped with
# hardcoded token addresses, which is Orbitwork mistake #7 sitting in the scaffolding — it was
# replaced with these variables on day one rather than "later".

# ── Network ──────────────────────────────────────────────────────────────────
# Unichain Sepolia is the deploy target: Uniswap's own testnet, with its own hookathon prize track.
UNICHAIN_SEPOLIA_RPC_URL=https://sepolia.unichain.org
CHAIN_ID=1301

# ── Deployer ─────────────────────────────────────────────────────────────────
# Prefer a Foundry keystore account over a raw key in a file:
#   cast wallet import antibody-deployer --interactive
#   forge script ... --account antibody-deployer
# PRIVATE_KEY is here only as an escape hatch. Never commit a filled-in .env.
PRIVATE_KEY=

# Owner of the deployed hook. Defaults to the deployer if unset.
HOOK_OWNER=

# ── Pool configuration ───────────────────────────────────────────────────────
# The two test tokens the demo pool trades. Ordering is normalised in BaseScript.
TOKEN0=
TOKEN1=

# Set after 00_DeployHook.s.sol runs. Later scripts read it; the deploy script does not.
HOOK_ADDRESS=

# ── Verification ─────────────────────────────────────────────────────────────
UNISCAN_API_KEY=

# ── Live-attack endpoint (Vercel serverless) ─────────────────────────────────
# The demo attack button calls a server function because these keys cannot ship
# in a browser bundle. Set the same values as Vercel project environment
# variables — never commit them.
#   DEMO_ATTACKER_KEY, DEMO_VICTIM_KEY, HOOK_ADDRESS, TOKEN0, TOKEN1
